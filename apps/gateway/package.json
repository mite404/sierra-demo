{
  "name": "gateway",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./contract": "./src/contract.ts",
    "./simulation-contract": "./src/simulationContract.ts"
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "check:simulation-runs": "node scripts/simulation-run-check.mjs",
    "dev": "wrangler dev",
    "dev:simulation": "pnpm migrate:simulation && wrangler dev --config wrangler.simulation.jsonc --local --persist-to .wrangler/simulation-state",
    "migrate:simulation": "wrangler d1 migrations apply SIMULATION_DB --config wrangler.simulation.jsonc --local --persist-to .wrangler/simulation-state",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@yaklabs/catalog": "workspace:*",
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@vitest/coverage-v8": "catalog:",
    "@yaklabs/config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.141.0"
  }
}
