{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sierra-demo-local-training",
  "main": "src/simulationWorker.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  // Allowlist this binding from .dev.vars or the orb environment, never the browser build.
  // Without it, Wrangler warns but the offline probe still runs.
  "secrets": { "required": ["OPENROUTER_API_KEY"] },
  "assets": {
    "directory": "../web/build/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
