{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // One Worker serves the static React Router build and the API, so the site has one origin
  // (ADR-086).
  "name": "yaklabs",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Built by `pnpm --filter web build`; it must exist before `wrangler dev` or a deploy.
    "directory": "../web/build/client",
    // Any path that is not a file gets index.html, and the app's router takes it from there.
    "not_found_handling": "single-page-application",
    // Only the API runs the Worker; every other request is a static file.
    "run_worker_first": ["/api/*"],
  },
  // Both bindings live in the dashboard: `WORKOS_CLIENT_ID` as a variable, `OPENROUTER_API_KEY`
  // as a secret (ADR-146). Nothing environment-specific is written here, and keep_vars stops a deploy from
  // replacing what the dashboard holds (a value named under `vars` would be replaced).
  "keep_vars": true,
  // Public threads, sealed, each deleted by KV when its share ends (ADR-131). No id: the first
  // deploy creates the namespace (Wrangler's automatic provisioning).
  "kv_namespaces": [{ "binding": "SHARES" }],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.05 },
  },
}
