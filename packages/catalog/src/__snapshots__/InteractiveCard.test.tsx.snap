// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`InteractiveCard, pinned before its split > opens on the payload's initial stop 1`] = `"<section class="card interactive-card" data-context="thread"><header class="card-heading"><div class="card-heading-text"><h2>Last week&#x27;s profit by day</h2></div></header><p class="live-sentence" aria-live="polite"><strong class="live-value">Gross profit</strong><span> was </span><strong class="live-value">$57.2k</strong><span> for </span><strong class="live-value">Sep 14–20</strong><span>, peaking on </span><strong class="live-value">Sat</strong><span> at </span><strong class="live-value">$11.2k</strong><span>.</span></p><div class="chart"><div class="recharts-responsive-container" style="width:100%;height:100%;min-width:0"><div style="width:0;height:0;overflow:visible"></div></div></div><div class="stepped"><label for="t1-measure">Profit measure</label><input id="t1-measure" type="range" min="0" max="2" step="1" aria-valuetext="Gross profit" style="--fill:0%" value="0"/><div class="stops"><button aria-pressed="true" tabindex="-1" data-edge="start" style="left:0%">Gross profit</button><button aria-pressed="false" tabindex="-1" style="left:50%">Operating profit</button><button aria-pressed="false" tabindex="-1" data-edge="end" style="left:100%">Net profit</button></div><p class="stop-description">Sales minus the cost of the goods you sold.</p></div><footer><span>Demo store sales · Sep 14–20</span><button class="btn btn-sm card-toggle" aria-expanded="false">Show my work</button></footer></section>"`;

exports[`InteractiveCard, pinned before its split > refuses an invalid payload with the catalog's limit card 1`] = `"<section class="card state" data-context="thread"><span class="state-symbol">↗</span><p class="eyebrow">CATALOG LIMIT</p><h2>We don’t have a safe view for this yet.</h2><p>This request is outside catalog v1 or its data contract. No unvalidated content was rendered.</p><p class="page-only">Try an approved view, or capture the missing capability below. We won’t substitute an unrelated chart.</p></section>"`;

exports[`InteractiveCard, pinned before its split > shows each stop the host holds, by label > Gross profit 1`] = `"<section class="card interactive-card" data-context="thread"><header class="card-heading"><div class="card-heading-text"><h2>Last week&#x27;s profit by day</h2></div></header><p class="live-sentence" aria-live="polite"><strong class="live-value">Gross profit</strong><span> was </span><strong class="live-value">$57.2k</strong><span> for </span><strong class="live-value">Sep 14–20</strong><span>, peaking on </span><strong class="live-value">Sat</strong><span> at </span><strong class="live-value">$11.2k</strong><span>.</span></p><div class="chart"><div class="recharts-responsive-container" style="width:100%;height:100%;min-width:0"><div style="width:0;height:0;overflow:visible"></div></div></div><div class="stepped"><label for="t1-measure">Profit measure</label><input id="t1-measure" type="range" min="0" max="2" step="1" aria-valuetext="Gross profit" style="--fill:0%" value="0"/><div class="stops"><button aria-pressed="true" tabindex="-1" data-edge="start" style="left:0%">Gross profit</button><button aria-pressed="false" tabindex="-1" style="left:50%">Operating profit</button><button aria-pressed="false" tabindex="-1" data-edge="end" style="left:100%">Net profit</button></div><p class="stop-description">Sales minus the cost of the goods you sold.</p></div><footer><span>Demo store sales · Sep 14–20</span><button class="btn btn-sm card-toggle" aria-expanded="false">Show my work</button></footer></section>"`;

exports[`InteractiveCard, pinned before its split > shows each stop the host holds, by label > Net profit 1`] = `"<section class="card interactive-card" data-context="thread"><header class="card-heading"><div class="card-heading-text"><h2>Last week&#x27;s profit by day</h2></div></header><p class="live-sentence" aria-live="polite"><strong class="live-value">Net profit</strong><span> was </span><strong class="live-value">$25.6k</strong><span> for </span><strong class="live-value">Sep 14–20</strong><span>, peaking on </span><strong class="live-value">Sat</strong><span> at </span><strong class="live-value">$5.9k</strong><span>.</span></p><div class="chart"><div class="recharts-responsive-container" style="width:100%;height:100%;min-width:0"><div style="width:0;height:0;overflow:visible"></div></div></div><div class="stepped"><label for="t1-measure">Profit measure</label><input id="t1-measure" type="range" min="0" max="2" step="1" aria-valuetext="Net profit" style="--fill:100%" value="2"/><div class="stops"><button aria-pressed="false" tabindex="-1" data-edge="start" style="left:0%">Gross profit</button><button aria-pressed="false" tabindex="-1" style="left:50%">Operating profit</button><button aria-pressed="true" tabindex="-1" data-edge="end" style="left:100%">Net profit</button></div><p class="stop-description">Operating profit minus interest and tax: what you keep.</p></div><footer><span>Demo store sales · Sep 14–20</span><button class="btn btn-sm card-toggle" aria-expanded="false">Show my work</button></footer></section>"`;

exports[`InteractiveCard, pinned before its split > shows each stop the host holds, by label > Operating profit 1`] = `"<section class="card interactive-card" data-context="thread"><header class="card-heading"><div class="card-heading-text"><h2>Last week&#x27;s profit by day</h2></div></header><p class="live-sentence" aria-live="polite"><strong class="live-value">Operating profit</strong><span> was </span><strong class="live-value">$34.1k</strong><span> for </span><strong class="live-value">Sep 14–20</strong><span>, peaking on </span><strong class="live-value">Sat</strong><span> at </span><strong class="live-value">$7.9k</strong><span>.</span></p><div class="chart"><div class="recharts-responsive-container" style="width:100%;height:100%;min-width:0"><div style="width:0;height:0;overflow:visible"></div></div></div><div class="stepped"><label for="t1-measure">Profit measure</label><input id="t1-measure" type="range" min="0" max="2" step="1" aria-valuetext="Operating profit" style="--fill:50%" value="1"/><div class="stops"><button aria-pressed="false" tabindex="-1" data-edge="start" style="left:0%">Gross profit</button><button aria-pressed="true" tabindex="-1" style="left:50%">Operating profit</button><button aria-pressed="false" tabindex="-1" data-edge="end" style="left:100%">Net profit</button></div><p class="stop-description">Gross profit minus rent, salaries, and other running costs.</p></div><footer><span>Demo store sales · Sep 14–20</span><button class="btn btn-sm card-toggle" aria-expanded="false">Show my work</button></footer></section>"`;
